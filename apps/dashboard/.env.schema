# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=true @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# URL points to the published host and port for the Service application (localhost:8083)
# when using the compose, ensure not to include trailing slash
# @type=url
NEXT_PUBLIC_API_URL=
# Disables/enables next auth during development, this gets short circuited when NEXT_ENV === production though
# @type=boolean
DISABLE_AUTH=
# Disables/enables next auth for client side auth state
# @type=boolean
NEXT_PUBLIC_DISABLE_AUTH
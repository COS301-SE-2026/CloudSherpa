{
  "_comment": "Primary font is Geist (not Inter). Geist features tabular figures by default — critical for vertically-aligned cost metrics. Geist Mono used for resource IDs, code, and raw metric values.",

  "font": {
    "family": {
      "main": { "value": "'Geist', sans-serif" },
      "mono": { "value": "'Geist Mono', monospace" }
    },

    "weight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" }
    },

    "size": {
      "xs":   { "value": "0.75rem" },
      "sm":   { "value": "0.875rem" },
      "base": { "value": "1rem" },
      "lg":   { "value": "1.25rem" },
      "xl":   { "value": "1.563rem" },
      "2xl":  { "value": "1.953rem" },
      "3xl":  { "value": "2.441rem" }
    },

    "lineHeight": {

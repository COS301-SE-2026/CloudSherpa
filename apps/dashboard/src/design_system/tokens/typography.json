    "h2": {
      "size":          { "value": "2rem" },
      "weight":        { "value": "{font.weight.semibold}" },
      "lineHeight":    { "value": "{font.lineHeight.tight}" },
      "letterSpacing": { "value": "{font.letterSpacing.snug}" },
      "usage":         { "value": "Section titles — major dashboard sections" }
    },
    "h3": {
      "size":          { "value": "1.5rem" },
      "weight":        { "value": "{font.weight.medium}" },
      "lineHeight":    { "value": "{font.lineHeight.snug}" },
      "letterSpacing": { "value": "{font.letterSpacing.normal}" },

# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=true @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Example: sherpa-db
POSTGRES_HOST=sherpa-db
# @type=port
# Example: 5432
POSTGRES_PORT=5432
# Example: sherpadb
POSTGRES_DB=sherpadb
# Example: cloudsherpa
POSTGRES_USER=cloudsherpa
# @sensitive
# Example: mock_pass
POSTGRES_PASSWORD=mock_pass
# @sensitive
# Example: mock_secret_32_chars_long_value_123456
AUTH_JWT_SECRET=mock_secret_32_chars_long_value_123456
# @sensitive
# Example: Base64-encoded AES-256 key generated with: openssl rand -base64 32
AES_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# @type=number
# Example: 60
AUTH_JWT_EXP_MINUTES=60
# @type=enum(dev, prod)
# Example: dev
SPRING_PROFILES_ACTIVE=dev
# Example: http://localhost:3000
DASHBOARD_HOST=http://localhost:3000
# @type=url
# Example: http://localhost:8081
INGESTION_BASE_URL=http://ingestion:8080
# @sensitive
INTELLIGENCE_API_KEY=abc123
# @sensitive
INGESTION_API_KEY=abc123
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=true @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Example: sherpa-db
POSTGRES_HOST=
# @type=port
# Example: 5432
POSTGRES_PORT=
# Example: sherpadb
POSTGRES_DB=
# Example: cloudsherpa
POSTGRES_USER=
# @sensitive
# Example: mock_pass
POSTGRES_PASSWORD=
# @sensitive
# Example: mock_secret_32_chars_long_value_123456
AUTH_JWT_SECRET=
# @sensitive
# Example: Base64-encoded AES-256 key generated with: openssl rand -base64 32
AES_ENCRYPTION_KEY=
# @type=number
# Example: 60
AUTH_JWT_EXP_MINUTES=
# @type=enum(dev, prod)
# Example: dev
SPRING_PROFILES_ACTIVE=
# Example: http://localhost:3000
DASHBOARD_HOST=
# @type=url
# Example: http://localhost:8081
INGESTION_BASE_URL=
# @sensitive
INTELLIGENCE_API_KEY=
# @sensitive
INGESTION_API_KEY=
# CloudSherpa LLM configuration

# @type=url
# Example: https://cloudsherpa-llm.gjjcs.org
AI_LLM_BASE_URL=

# Cloudflare Access service token client ID
# Example: 8532456464d32.access
AI_LLM_CLIENT_ID=

# Cloudflare Access service token client secret
# @sensitive
# Example: your-cloudflare-access-client-secret
AI_LLM_CLIENT_SECRET=

# LLM model identifier
# Example: qwen2.5-coder:14b-instruct
AI_LLM_MODEL=

# Maximum number of tool-calling rounds per agent request
# @type=number
# Example: 10
AI_LLM_MAX_TOOL_ROUNDS=


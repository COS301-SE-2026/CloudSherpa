# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=true @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Example: sherpa-db
POSTGRES_HOST=
# @type=port
# Example: 5432
POSTGRES_PORT=
# Example: sherpadb
POSTGRES_DB=
# Example: cloudsherpa
POSTGRES_USER=
# @sensitive
# Example: mock_pass
POSTGRES_PASSWORD=
# @sensitive
# Example: mock_secret_32_chars_long_value_123456
AUTH_JWT_SECRET=
# @sensitive
# Example: Base64-encoded AES-256 key generated with: openssl rand -base64 32
AES_ENCRYPTION_KEY=
# @type=number
# Example: 60
AUTH_JWT_EXP_MINUTES=
# @type=enum(dev, prod)
# Example: dev
SPRING_PROFILES_ACTIVE=
# Example: http://localhost:3000
DASHBOARD_HOST=
# @type=url
# Example: http://localhost:8081
INGESTION_BASE_URL=

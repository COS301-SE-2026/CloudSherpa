# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# 
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------
# @sensitive
# Example: Base64-encoded AES-256 key generated with: openssl rand -base64 32
AES_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# @sensitive
API_KEY=abc123
# Example: sherpa-db
POSTGRES_HOST=sherpa-db
# @type=port
# Example: 5432
POSTGRES_PORT=5432
# Example: sherpadb
POSTGRES_DB=sherpadb
# Example: cloudsherpa
POSTGRES_USER=cloudsherpa
# @sensitive
# Example: mock_pass
POSTGRES_PASSWORD=mock_pass

# @type=enum(dev, prod)
# Example: dev
SPRING_PROFILES_ACTIVE=dev

# @type=boolean
# @required=false
# Example: false
DEV_GCP_BILLING_DEV=false
# @required=false
# Example: a0000000-0000-0000-0000-000000000002
DEV_GCP_ACCOUNT_ID=a0000000-0000-0000-0000-000000000002
# @required=false
# Example: my-gcp-project
DEV_GCP_PROJECT_ID=my-gcp-project
# @required=false
# Example: billing_export_dataset
DEV_GCP_DATASET_ID=billing_export_dataset
# @required=false
# Example: 000000-000000-000000
DEV_GCP_BILLING_ACCOUNT_ID=000000-000000-000000
# @required=false
# Example: /absolute/path/to/dev-gcp-service-account.json
DEV_GCP_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/dev-gcp-service-account.json
# @required=false
# Example: e0000000-0000-0000-0000-000000000002
DEV_GCP_BILLING_CONFIG_ID=e0000000-0000-0000-0000-000000000002
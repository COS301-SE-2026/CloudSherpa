// ==========================================
// PUBLIC SCHEMA (Shared across all tenants)
// ==========================================

Table users {
  user_id uuid [pk]
  email varchar(320) [unique]
  username varchar(100)
  password_hash varchar(255)
  created_at timestamptz
}

Table preferences {
  user_id uuid [pk, ref: - users.user_id]
  theme theme_enum
  background text
  currency currency_enum
  language language_enum
  sidebar_toggle boolean
}

Table cloud_connection {
  connection_id uuid [pk]
  user_id uuid [ref: > users.user_id]
  provider provider_enum
  status status_enum
  created_at timestamptz
}

Table cloud_account {
  account_id uuid [pk]
  connection_id uuid [ref: > cloud_connection.connection_id]
  account_type account_type_enum
  ingestion_period ingestion_period_enum
  display_name varchar(255)
  created_at timestamptz
  last_usage_ingestion timestamptz
  next_usage_ingestion timestamptz
  last_billing_ingestion timestamptz
  next_billing_ingestion timestamptz
}

Table offered_metric {
  offered_metric_id uuid [pk]
  provider provider_enum
  service_type varchar(255)
  metric_name varchar(255)
  identifier_field varchar(100)
  expected_unit varchar(50)
  description text

  Indexes {
    (provider, service_type, metric_name) [unique]
  }
}

Table cloud_credential {
  credential_id uuid [pk]
  account_id uuid [unique, ref: - cloud_account.account_id]
  provider provider_enum
  credential_type credential_type_enum
  credential_value text
  created_at timestamptz
}

Table billing_export_config {
  config_id uuid [pk]
  account_id uuid [ref: > cloud_account.account_id]
  bucket_name varchar(255)
  bucket_region varchar(255)
  export_prefix varchar(255)
  export_name varchar(255)
  created_at timestamptz
}

Table billing_export_execution {
  execution_id uuid [pk]
  config_id uuid [ref: > billing_export_config.config_id]
  status execution_status_enum
  rows_processed integer
  started_at timestamptz
  completed_at timestamptz
  error_message text
}

Table dashboard {
  dashboard_id uuid [pk]
  display_name varchar(255)
  user_id uuid [ref: > users.user_id]
  time_from timestamptz
  time_to timestamptz
  predefined_time predefined_time_enum
  current boolean
}

Table widget {
  widget_id uuid [pk]
  dashboard_id uuid [ref: > dashboard.dashboard_id]
  type type_enum
  start_x integer
  start_y integer
  width integer
  height integer
  display_name varchar(100)
}

Table widget_kpi {
  kpi_id uuid [pk]
  widget_id uuid [ref: > widget.widget_id]
  aggregation integer
}

Table kpi_charges {
  kpi_charges_id uuid [pk]
  widget_kpi_id uuid [ref: > widget_kpi.kpi_id]
  charge_id varchar(2128)
}

Table widget_chart {
  chart_id uuid [pk]
  widget_id uuid [ref: > widget.widget_id]
  chart_type chart_type_enum
}

Table chart_resource {
  chart_resource_id uuid [pk]
  widget_chart_id uuid [ref: > widget_chart.chart_id]
  resource_id uuid
  metric_type varchar(50)
}

// ==========================================
// TENANT SCHEMA TEMPLATE (e.g. tenant_xxxx)
// ==========================================

Table resource {
  resource_id uuid [pk]
  account_id uuid [ref: > cloud_account.account_id]
  resource_type varchar(255)
  resource_name varchar(255)
  resource_identifier varchar(255)
  resource_identifier_type varchar(255)
  region varchar(100)
  status status_enum
  tags jsonb
  last_updated timestamptz
  created_at timestamptz

  Indexes {
    tags [name: "ix_resource_tags", type: gin]
    (account_id, resource_type, resource_identifier, region) [unique]
  }
}

Table normalized_metrics {
  metric_id uuid
  resource_id uuid [ref: > resource.resource_id]
  recorded_at timestamptz
  metric_type varchar(50)
  metric_name varchar(255)
  metric_value numeric
  unit varchar(50)
  currency varchar(10)
  period_start timestamptz
  period_end timestamptz

  Indexes {
    (metric_id, period_start) [pk]
    (resource_id, metric_name, period_start) [name: "ix_tenant_resource_metric_time"]
  }
}

Table normalized_costs {
  cost_id text
  execution_id uuid [ref: > billing_export_execution.execution_id]
  resource_id varchar(2048)
  charge_id varchar(2128)
  provider provider_enum
  billing_account_id varchar(255)
  service_name varchar(255)
  charge_type charge_type_enum
  cost_amount numeric
  currency currency_enum
  usage_start_time timestamptz
  usage_end_time timestamptz
  metadata jsonb

  Indexes {
    (cost_id, usage_start_time) [pk]
    (resource_id, usage_start_time) [name: "ix_tenant_costs_resource_time"]
    (service_name, usage_start_time) [name: "ix_tenant_costs_service_time"]
  }
}

Table optimization_metric_statistics {
  statistics_id uuid [pk]
  resource_id uuid [ref: > resource.resource_id]
  provider provider_enum
  metric_name varchar(255)
  window_type varchar(10)

  minimum_value numeric
  maximum_value numeric
  average_value numeric
  median_value numeric
  p95_value numeric
  p99_value numeric
  standard_deviation numeric
  spike_count integer
  peak_duration_seconds integer
  completeness_ratio numeric

  window_start timestamptz
  window_end timestamptz
  calculated_at timestamptz
}

Table optimization_recommendation {
  recommendation_id uuid [pk]
  resource_id uuid [ref: > resource.resource_id]
  provider provider_enum
  rule_id varchar(255)
  action_type varchar(50)
  status optimization_status_enum
  evidence jsonb
  created_at timestamptz
  updated_at timestamptz
  expires_at timestamptz
}

Table recommendation_history {
  history_id uuid [pk]
  recommendation_id uuid [ref: > optimization_recommendation.recommendation_id]
  resource_id uuid [ref: > resource.resource_id]
  provider provider_enum
  rule_id varchar(255)
  action_type varchar(50)
  previous_status optimization_status_enum
  new_status optimization_status_enum
  evidence jsonb
  changed_at timestamptz
}

Table processing_watermark {
  pipeline_name varchar(255) [pk]
  last_processed_period timestamptz
  last_successful_run timestamptz
  updated_at timestamptz
}
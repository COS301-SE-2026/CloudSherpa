server {
    # Domain
    server_name staging.gjjcs.org;

    auth_basic  "CloudSherpa Demo1";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Root directory for static files, primarily used for testing and Shield.io uptime 
    root /var/www/html;
    index cloudsherpa-hi.html;

    # Logs
    access_log /var/log/nginx/cloudsherpa.access.log;
    error_log  /var/log/nginx/cloudsherpa.error.log;    

    # Reverse proxying to containerized deployment, where the dashboard container publishes its port to the host
    location / {
        proxy_pass http://localhost:3000/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for SSE
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /api/ {
        auth_basic off;
        proxy_pass http://localhost:8083/;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

    }

    location /hi/ {
        auth_basic off;
        try_files /cloudsherpa-hi.html =404;
    }

    # Rate limiting (wip)
    #   limit_req zone=one burst=10 nodelay;


    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Deny hidden files
    location ~ /\. {
        deny all;
    }

    # TLS config for HTTPS traffic, DO NOT TOUCH, managed by Certbot as comments suggest
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/cloudsherpa.gjjcs.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/cloudsherpa.gjjcs.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

# Certbot managed block that upgrades connection to serve over HTTPS when HTTP request made
server {
    if ($host = cloudsherpa.gjjcs.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name cloudsherpa.gjjcs.org;
    return 404; # managed by Certbot


}